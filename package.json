{
  "name": "ecommerce-iq",
  "version": "1.0.0",
  "description": "AI-powered ecommerce intelligence platform for product insights, market analysis, and competitive intelligence",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ecommerce-iq": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "cli": "tsx src/cli.ts",
    "setup": "tsx scripts/setup.ts",
    "demo": "tsx scripts/demo.ts",
    "seed": "tsx scripts/seed.ts",
    "dashboard": "tsx src/dashboard/static-server.ts",
    "dashboard:dev": "tsx watch src/dashboard/static-server.ts",
    "start:all": "bash scripts/start-all.sh",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ecommerce",
    "ai",
    "intelligence",
    "analytics",
    "market-research",
    "product-search",
    "sentiment-analysis"
  ],
  "author": "EcommerceIQ Team",
  "license": "MIT",
  "dependencies": {
    "@types/compression": "^1.8.1",
    "@types/morgan": "^1.9.10",
    "axios": "^1.6.2",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^2.0.9",
    "morgan": "^1.10.1",
    "ora": "^8.0.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/http-proxy-middleware": "^1.0.0",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
